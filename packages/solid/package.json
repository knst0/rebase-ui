{
  "name": "@rebase-ui/solid",
  "version": "0.5.0",
  "description": "Headless, accessible UI primitives for Solid.js, ported from Base UI.",
  "keywords": [
    "accessible",
    "base-ui",
    "components",
    "headless",
    "solid",
    "solid-js",
    "ui"
  ],
  "homepage": "https://rebase.ui.knst.dev",
  "license": "MIT",
  "author": "Konstantin Kireyev <https://github.com/knst0>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knst0/rebase-ui.git",
    "directory": "packages/solid"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#prehydration/slider/thumb": {
      "browser": "./src/internals/prehydration-script/prehydrationScript.stub.ts",
      "default": "./src/slider/thumb/prehydrationScript.min.ts"
    },
    "#prehydration/tabs/indicator": {
      "browser": "./src/internals/prehydration-script/prehydrationScript.stub.ts",
      "default": "./src/tabs/indicator/prehydrationScript.min.ts"
    },
    "#test-utils": "./test/index.ts",
    "#utils/*": "./src/internals/utils/*.ts"
  },
  "exports": {
    "./accordion": "./src/accordion/index.ts",
    "./alert-dialog": "./src/alert-dialog/index.ts",
    "./avatar": "./src/avatar/index.ts",
    "./button": "./src/button/index.ts",
    "./collapsible": "./src/collapsible/index.ts",
    "./dialog": "./src/dialog/index.ts",
    "./checkbox": "./src/checkbox/index.ts",
    "./checkbox-group": "./src/checkbox-group/index.ts",
    "./combobox": "./src/combobox/index.ts",
    "./field": "./src/field/index.ts",
    "./fieldset": "./src/fieldset/index.ts",
    "./form": "./src/form/index.ts",
    "./meter": "./src/meter/index.ts",
    "./scroll-area": "./src/scroll-area/index.ts",
    "./separator": "./src/separator/index.ts",
    "./slider": "./src/slider/index.ts",
    "./switch": "./src/switch/index.ts",
    "./tabs": "./src/tabs/index.ts",
    "./toggle": "./src/toggle/index.ts",
    "./toggle-group": "./src/toggle-group/index.ts",
    "./tooltip": "./src/tooltip/index.ts",
    "./popover": "./src/popover/index.ts",
    "./preview-card": "./src/preview-card/index.ts",
    "./select": "./src/select/index.ts"
  },
  "publishConfig": {
    "imports": {
      "#prehydration/slider/thumb": {
        "browser": "./dist/internals/prehydration-script/prehydrationScript.stub.ts",
        "default": "./dist/slider/thumb/prehydrationScript.min.ts"
      },
      "#prehydration/tabs/indicator": {
        "browser": "./dist/internals/prehydration-script/prehydrationScript.stub.ts",
        "default": "./dist/tabs/indicator/prehydrationScript.min.ts"
      }
    },
    "exports": {
      "./accordion": "./dist/accordion/index.js",
      "./alert-dialog": "./dist/alert-dialog/index.js",
      "./avatar": "./dist/avatar/index.js",
      "./button": "./dist/button/index.js",
      "./collapsible": "./dist/collapsible/index.js",
      "./combobox": "./dist/combobox/index.js",
      "./dialog": "./dist/dialog/index.js",
      "./checkbox": "./dist/checkbox/index.js",
      "./checkbox-group": "./dist/checkbox-group/index.js",
      "./field": "./dist/field/index.js",
      "./fieldset": "./dist/fieldset/index.js",
      "./form": "./dist/form/index.js",
      "./meter": "./dist/meter/index.js",
      "./scroll-area": "./dist/scroll-area/index.js",
      "./separator": "./dist/separator/index.js",
      "./slider": "./dist/slider/index.js",
      "./switch": "./dist/switch/index.js",
      "./tabs": "./dist/tabs/index.js",
      "./toggle": "./dist/toggle/index.js",
      "./toggle-group": "./dist/toggle-group/index.js",
      "./tooltip": "./dist/tooltip/index.js",
      "./popover": "./dist/popover/index.js",
      "./preview-card": "./dist/preview-card/index.js",
      "./select": "./dist/select/index.js"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "inline-scripts": "node ./scripts/inline-scripts.mjs",
    "prepack": "tsdown"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@floating-ui/utils": "^0.2.12"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^1.0.0-beta.3",
    "@solidjs/vite-plugin": "3.0.0-next.43",
    "@solidjs/web": "^2.0.0-rc.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "jsdom": "^30.0.1",
    "oxc-minify": "^0.149.0",
    "solid-js": "^2.0.0-rc.8",
    "tsdown": "^0.23.0"
  },
  "peerDependencies": {
    "@solidjs/web": ">=2.0.0-rc.0 || >=2",
    "solid-js": ">=2.0.0-rc.0 || >=2"
  }
}
