{
  "name": "@rebase-ui/core",
  "version": "0.14.3",
  "description": "Framework-free internal utilities shared by @rebase-ui/solid.",
  "license": "MIT",
  "author": "Konstantin Kireyev <https://github.com/knst0>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knst0/rebase-ui.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "devDependencies": {
    "tsdown": "^0.23.0"
  }
}
