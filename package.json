{
  "name": "@rebase-ui/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @rebase-ui/solid build",
    "changeset": "changeset",
    "fmt": "vp fmt",
    "lint": "vp lint --type-aware --type-check",
    "test": "pnpm test:chromium",
    "test:browsers": "cross-env VITEST_ENV=all-browsers pnpm test:unit",
    "test:chromium": "cross-env VITEST_ENV=chromium pnpm test:unit",
    "test:ci": "vp test run --project @rebase-ui/docs && cross-env VITEST_ENV=chromium vp test run --project @rebase-ui/solid",
    "test:firefox": "cross-env VITEST_ENV=firefox pnpm test:unit",
    "test:package": "pnpm build && vp test run --project @rebase-ui/solid-package",
    "test:unit": "vp test --project @rebase-ui/solid",
    "test:webkit": "cross-env VITEST_ENV=webkit pnpm test:unit",
    "typecheck": "tsc --noEmit -p packages/solid/tsconfig.json && tsc --noEmit -p docs/tsconfig.json",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@rebase-ui/monorepo-tests": "workspace:*",
    "@solidjs/diagnostics": "2.0.0-rc.2",
    "@types/node": "^26.6.2",
    "@vitest/browser-playwright": "catalog:",
    "cross-env": "^10.1.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.3.0"
}
